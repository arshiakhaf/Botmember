# توکن ربات (از BotFather)
BOT_TOKEN=123456789:ABC-DEF...

# مشخصات اپلیکیشن تلگرام — از https://my.telegram.org (بخش API development)
# بدون این دو مقدار، امکان اضافه کردن عضو با شماره وجود ندارد.
API_ID=123456
API_HASH=abcdef1234567890abcdef

# آی‌دی عددی ادمین‌های مجاز (با کاما جدا کنید).
# اگر خالی باشد، فقط صاحب حساب یوزربات (بعد از لاگین) دسترسی دارد.
ADMIN_IDS=

# نام فایل سشن (پیش‌فرض account)
SESSION_NAME=account

# کد کشور پیش‌فرض برای شماره‌ها (ایران = 98)
DEFAULT_COUNTRY_CODE=98
