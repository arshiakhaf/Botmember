# توکن ربات (از BotFather)
BOT_TOKEN=123456789:ABC-DEF...

# آی‌دی عددی ادمین‌ها (با کاما جدا کنید). برای گرفتن آی‌دی خود، به ربات /id بدهید.
ADMIN_IDS=

# اطلاعات کارت برای واریز
CARD_NUMBER=6037-9970-1234-5678
CARD_HOLDER=نام صاحب کارت

# آیدی/یوزرنیم پشتیبانی
SUPPORT=@support

# --- حالت وب‌هوک (برای هاست رایگان مثل Render) ---
# اگر خالی باشد، ربات با polling اجرا می‌شود (اجرای محلی).
# در Render نیازی به تنظیم نیست؛ RENDER_EXTERNAL_URL خودکار استفاده می‌شود.
# مثال: WEBHOOK_URL=https://botmember-shop.onrender.com
WEBHOOK_URL=

# مسیر و پورت وب‌هوک (معمولاً تغییری لازم نیست)
WEBHOOK_PATH=/webhook
PORT=8080
